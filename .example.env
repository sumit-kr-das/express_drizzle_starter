# Runtime
PORT=8000
NODE_ENV=development

# CORS
ORIGIN_FRONTEND=http://localhost:5173
ORIGIN_ADMIN=http://localhost:5174
ORIGIN_FRONTEND_WWW=

# Bcrypt
SALT=10

# JWT / Tokens (use long random strings, NOT bcrypt hashes)
ACCESS_SECRET=change-this-to-a-long-random-string
REFRESH_SECRET=change-this-to-another-long-random-string

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SRC=true
SMTP_MAIL=
SMTP_PASSWORD=   # use a Gmail App Password if applicable

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (service name on the docker network)
DATABASE_URL=postgresql://postgres:123456@localhost:5438/my_project

# Cloudinary (leave blank if unused)
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=

# MinIO (leave blank if unused)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Razorpay
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=

# Google reCAPTCHA (NO spaces around =)
GOOGLE_RECAPTCHA_SECRET_KEY=
